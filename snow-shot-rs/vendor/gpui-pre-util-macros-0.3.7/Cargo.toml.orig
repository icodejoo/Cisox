[package]
name = "gpui-pre-util-macros"
version = "0.3.7"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Utility macros for Zed (gpui-pre snapshot of zed@1a28cff)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "util_macros"
zed-version = "0.1.0"
zed-rev = "1a28cff4b409169bac058bca40dfbfeb7621d19b"

[lib]
path = "src/util_macros.rs"
proc-macro = true
test = false
name = "util_macros"

[features]
perf-enabled = []

[dependencies]
quote = { workspace = true }
syn = { workspace = true }
perf = { workspace = true }

[lints]
workspace = true
