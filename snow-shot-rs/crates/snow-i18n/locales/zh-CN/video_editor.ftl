# 视频剪辑窗

video-editor-info = { $duration } · { $width }×{ $height } · { $keyframes } 个关键帧
video-editor-probing = 正在读取视频信息…
video-editor-probe-failed = 无法读取这个视频：{ $reason }
video-editor-preview-loading = 预览加载中…
video-editor-preview-failed = 这个位置没有可用的预览
video-editor-close = 关闭
video-editor-exporting = 正在导出… { $percent }%
video-editor-exporting-unknown = 正在导出…
video-editor-done = 已保存：{ $name }
video-editor-reveal = 在资源管理器中显示
video-editor-failed = 导出失败：{ $reason }
video-editor-export = 导出
video-editor-play = 播放
video-editor-pause = 暂停
video-editor-split = 分割
video-editor-delete = 删除
video-editor-restore = 恢复
video-editor-time = { $now } / { $total }
video-editor-off-keyframe = 切点不在关键帧上，导出时将对齐到关键帧
video-editor-no-engine = 系统播放引擎不可用，只能拖动查看静态画面

video-editor-save-frame = 保存当前帧
video-editor-save-frame-title = 保存当前帧
video-editor-save-frame-filter = PNG 图片 (*.png)
video-editor-frame-failed = 保存当前帧失败：{ $reason }
