## Scrolling screenshot: control bar, hints and failures.

scroll-reject-no-features = Not enough content to align. Pick an area with text or patterns.

scroll-reject-no-matches = The frames do not line up. Scroll more slowly.

scroll-reject-low-confidence = Not sure about the alignment (repeating texture or animation). Scroll more slowly.

scroll-reject-scene-cut = The whole picture changed; the page may have switched.

scroll-reject-too-fast = Scrolling too fast. Slow down (no more than half a screen at a time).

scroll-reject-unknown = This frame could not be added.

scroll-hint-limit = Reached the height limit ({ $height } px), finishing automatically.

scroll-hint-auto-failed = Auto scroll is unavailable: { $detail }. Please scroll manually.

scroll-hint-auto-unsupported = Auto scroll is not supported here. Please scroll manually.

scroll-hint-read-failed = Could not read the screen: { $detail }

scroll-hint-bottom = Scrolled to the bottom, finishing automatically.

scroll-fail-stitch = { $detail }

scroll-fail-capture = Reading the screen kept failing: { $detail }

scroll-fail-nothing = Nothing was captured.

scroll-fail-output = { $detail }

scroll-copy-disabled = not enabled

scroll-copy-too-large = image too large ({ $size } MB), saved to files only

scroll-status-mode-auto = auto scroll

scroll-status-mode-manual = scroll the content

scroll-status-title = Scrolling capture - { $mode }

scroll-status-title-frames = Scrolling capture - { $frames } frames - { $width }x{ $height } - { $mode }

scroll-status-hint-default = Scroll less than half a screen at a time; click "Finish" when done.

scroll-status-saving = Saving...

scroll-status-copied = copied to the clipboard

scroll-status-not-copied = not copied ({ $why })

scroll-status-copy-failed = copy failed ({ $detail })

scroll-status-done = Done - { $width }x{ $height } - { $copied }

scroll-status-saved-files = Saved { $count } files

scroll-status-failed = Scrolling capture failed

scroll-status-cancelled = Cancelled

scroll-btn-auto-on = Auto scroll: on

scroll-btn-auto-off = Auto scroll: off

scroll-btn-finish = Finish

scroll-btn-cancel = Cancel

scroll-btn-close = Close
