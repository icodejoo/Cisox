## Screen recording: control bar texts, format names and failures.

recording-ui-countdown = Starts in { $seconds } s

recording-ui-cancel = Discard

recording-ui-pause = Pause

recording-ui-resume = Resume

recording-ui-finish = Finish

recording-ui-close = Close

recording-ui-saving = Saving...

recording-ui-failed = Recording failed: { $reason }

recording-format-mp4 = MP4 video

recording-format-gif = GIF animation

recording-format-apng = APNG animation

