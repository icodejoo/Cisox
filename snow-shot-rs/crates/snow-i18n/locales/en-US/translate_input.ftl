## 输入框翻译浮窗（热键唤起，手写）

translate-input-placeholder = Type or paste text to translate

translate-input-button = Translate

translate-input-working = Translating... the first run loads the model, please wait

translate-input-result-empty = The translation will appear here

translate-input-click-copy = Click the translation to copy it

translate-input-copied = Copied

translate-input-copy-failed = Copy failed: { $reason }

translate-input-model-auto = Auto

translate-input-model-label = Model

translate-input-error-empty = Nothing to translate. Type some text first.

translate-input-error-no-model = No translation model is installed. Put a model folder into the translation models directory first.

translate-input-error-runtime = The translation runtime is missing. Download it from the screenshot translation panel first.

translate-input-error-pair = The selected model does not cover this language pair.

translate-input-error-timeout = Translation timed out. Try again or use a shorter text.

translate-input-error-failed = Translation failed: { $detail }

translate-input-from-model = Model: { $name }
