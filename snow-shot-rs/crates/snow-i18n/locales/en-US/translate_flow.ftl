## Screenshot translation panel in the overlay: progress, results and failures.

translate-flow-stage-recognizing = Recognizing text...

translate-flow-stage-translating = Translating... (the first run loads the model, please wait)

translate-flow-ocr-hint = { $message } Click the "OCR" button and press D to download the OCR components, then come back to translate.

translate-flow-no-text = No translatable text was found.

translate-flow-already-target = The text is already in { $lang }, so there is nothing to translate (you can change the target language in Settings).

translate-flow-done-copied = Translated; the translation was copied to the clipboard

translate-flow-done-copy-failed = Translated (copying to the clipboard failed)

translate-flow-empty = The translation is empty

translate-flow-press-d = { $message } - press D to download

translate-flow-downloading-hint = After the download finishes, click "Translate" again.

translate-flow-title = Translation - { $label }

translate-flow-more-paragraphs = ... ({ $count } more paragraphs)

translate-flow-footer-copied = Copied - Enter copies and closes - Esc goes back

translate-flow-footer-copy-failed = Copy failed - Enter retries and closes - Esc goes back

translate-flow-download-hint = Press D to download the onnxruntime runtime (about 14 MB, official release, hash verified)

translate-flow-esc = Esc to go back

translate-flow-error-no-model = No usable translation model was found. Put a model folder into the translation models directory. Details: { $detail }

translate-flow-error-pair = Unsupported language pair: { $source } to { $target }

translate-flow-error-invalid-request = Invalid translation request: { $detail }

translate-flow-error-network = Could not reach the translation endpoint: { $detail }

translate-flow-error-io = Could not read the model files: { $detail }

translate-flow-error-timeout = The translation timed out.

translate-flow-error-runtime-missing = The onnxruntime runtime is missing ({ $detail }).

translate-flow-error-worker-unavailable = The translation component is unavailable: { $detail }

translate-flow-error-worker-died = The translation process exited unexpectedly: { $detail }

translate-flow-error-model-load = The translation model failed to load: { $detail }

translate-flow-error-inference = Translation failed: { $detail }

translate-flow-error-oom = Translation ran out of memory: { $detail }

translate-flow-error-no-custom-model = No custom AI model is configured yet. Add an OpenAI-compatible endpoint under "Custom models" first.

translate-flow-error-custom-model-not-selected = Pick a custom AI model for text translation in Settings.
