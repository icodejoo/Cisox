## Pinned image store and group errors.

pin-group-default-name = Group { $n }

pin-error-group-name-empty = The group name cannot be empty.

pin-error-group-name-too-long = The group name cannot be longer than { $max } characters.

pin-error-group-name-taken = A group with this name already exists.

pin-error-too-many-groups = The number of groups has reached the limit.

pin-error-delete-default-group = The default group cannot be deleted.

pin-error-group-missing = The group does not exist.

pin-error-pin-missing = The pinned image does not exist.

pin-error-payload-missing = The pinned image content does not exist.

pin-error-source-missing = The pinned image has no source picture.

pin-error-decode-failed = Could not decode the source picture: { $detail }

pin-error-store = Could not read or write the pinned image store: { $detail }
