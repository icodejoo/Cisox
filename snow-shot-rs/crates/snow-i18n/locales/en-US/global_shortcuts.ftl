## Global hotkeys, overlay keys and mouse gestures: hints and notes for features that are not implemented yet.

global-hotkey-not-implemented = "{ $action }" is not implemented yet.

global-hotkey-placeholder-note = The shortcut can be bound, but this feature is not implemented yet. Pressing it only shows a hint.

global-hotkey-open-folder-failed = Could not open the folder: { $reason }

global-hotkeys-turned-on = Global hotkeys are on.

global-hotkeys-turned-off = Global hotkeys are off. Press the toggle shortcut to turn them back on.

global-hotkey-fullscreen-suppression-on = Global hotkeys are paused while a full-screen window has focus.

global-hotkey-fullscreen-suppression-off = Global hotkeys stay active in full-screen windows.

global-mouse-not-implemented-note = Global mouse gestures are not implemented yet. This setting is saved but has no effect.

overlay-key-not-implemented = "{ $action }" is not implemented yet.
